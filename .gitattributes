# Автоматическое определение текстовых файлов и единый формат переноса строк LF
* text=auto eol=lf
# Явное указание текстовых файлов
*.html text
*.css  text
*.js   text
*.json text
*.md   text
# Явное указание бинарных файлов (изображения, архивы)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.psd  binary
